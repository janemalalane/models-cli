# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-gcp-region
GOOGLE_CLOUD_STORAGE_BUCKET=your-gcs-bucket
SERVICE_ACCOUNT_EMAIL=your-service-account-email

# Model Identifier (Single Source of Truth)
MODEL_ID=your-model-id

# Optional: Hugging Face Access Token (for gated model downloads)
HF_TOKEN=your-huggingface-access-token

# Deployed Endpoint (populated after models-cli deploy)
ENDPOINT_URL=your-deployed-endpoint-url
